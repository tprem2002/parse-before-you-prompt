# Local application
APP_NAME=Parse Before You Prompt
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8080
PBTP_API_BASE_URL=http://127.0.0.1:8080
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8501,http://localhost:8501
LOG_LEVEL=INFO

# Local demo services. The parse_prompt password is for local demonstration only.
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+psycopg://parse_prompt:parse_prompt@localhost:5432/parse_prompt
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_SSL=false

# Project-owned runtime data (ignored by Git)
UPLOAD_ROOT=./data/uploads
ARTIFACT_ROOT=./data/artifacts
HF_HOME=./data/model-cache/huggingface
DOCLING_ARTIFACTS_PATH=

# Local Docling conversion
DOCLING_DEVICE=auto
DOCLING_NUM_THREADS=4
DOCLING_MAX_FILE_SIZE_MB=25
DOCLING_MAX_PAGES=30
DOCLING_IMAGE_SCALE=2.0
DOCLING_ENABLE_PICTURE_DESCRIPTION=true
DOCLING_ENABLE_FORMULA_ENRICHMENT=true
DOCLING_ENABLE_CODE_ENRICHMENT=true
DOCLING_ENABLE_CHART_EXTRACTION=false
DOCLING_ENABLE_VLM_COMPARISON=true

# Chunking and RAG controls
CHUNK_MAX_TOKENS=800
BASELINE_CHUNK_OVERLAP_TOKENS=100
CHUNK_MERGE_PEERS=true
CHUNK_REPEAT_TABLE_HEADER=true
CHUNK_OMIT_HEADER_ON_OVERFLOW=false
TIKTOKEN_MODEL_HINT=text-embedding-3-large
TIKTOKEN_FALLBACK_ENCODING=cl100k_base
EMBEDDING_BATCH_MAX_INPUTS=16
EMBEDDING_BATCH_MAX_TOKENS=8000
RAG_TOP_K=5
RAG_MAX_TOP_K=20
RAG_PROMPT_VERSION=parse-before-you-prompt-rag-v1
RAG_MAX_EVIDENCE_TOKENS=6000
RAG_MAX_QUESTION_CHARS=4000
CHAT_TEMPERATURE=
CHAT_REASONING_EFFORT=low
CHAT_MAX_OUTPUT_TOKENS=2000
CHAT_STRUCTURED_OUTPUT_RETRY_COUNT=1

# One bounded in-process worker
PROCESSING_WORKER_ENABLED=true
PROCESSING_WORKER_POLL_SECONDS=1.0
PROCESSING_WORKER_CONCURRENCY=1
PROCESSING_STALE_AFTER_MINUTES=60
PROCESSING_SHUTDOWN_TIMEOUT_SECONDS=30
ALLOW_DEMO_RESET=false

# Your Azure OpenAI resource and Azure deployment names
AZURE_OPENAI_BASE_URL=https://YOUR_RESOURCE_NAME.openai.azure.com/openai/v1/
AZURE_OPENAI_AUTH_MODE=api_key
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_TOKEN_SCOPE=https://cognitiveservices.azure.com/.default
AZURE_OPENAI_MANAGED_IDENTITY_CLIENT_ID=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.1
AZURE_OPENAI_REQUEST_TIMEOUT_SECONDS=120
AZURE_OPENAI_MAX_RETRIES=2
